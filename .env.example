# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored, so your real values are never committed.
# This template (.env.example) is safe to commit — it contains no secrets.

# Required by NCBI: a real email so they can contact you if a script misbehaves.
ENTREZ_EMAIL=you@example.com

# Optional: a free NCBI API key raises your rate limit from 3 to 10 requests/sec.
# Get one at https://www.ncbi.nlm.nih.gov/account/ -> Settings -> API Key Management.
# Leave blank if you don't have one; the fetcher still works, just a little slower.
NCBI_API_KEY=